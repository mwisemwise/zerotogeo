# =============================================================================
# Zero to GEO — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Application ----
APP_ENV=development
# Options: development | production | test

APP_DEBUG=true

# ---- Backend Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# ---- Database ----
# SQLite (default for development):
DATABASE_URL=sqlite:///./zero_to_geo.db

# PostgreSQL (for production — uncomment and configure):
# DATABASE_URL=postgresql://user:password@localhost:5432/zero_to_geo

# ---- Crawling ----
# Maximum seconds to wait for a page to respond
CRAWL_TIMEOUT_SECONDS=15

# Maximum number of pages to crawl per audit (MVP: 1–5)
CRAWL_MAX_PAGES=5

# Respect robots.txt (strongly recommended: true)
CRAWL_RESPECT_ROBOTS=true

# User-agent string sent with crawl requests
CRAWL_USER_AGENT=ZeroToGEO/0.1 (+https://zerotogeo.com/bot)

# ---- CORS ----
# Comma-separated allowed origins for the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Optional: LLM Enhancement (not required for MVP) ----
# Leave blank to use deterministic analysis only.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=

# ---- Security ----
# Secret key for signing (used if/when sessions are added)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production
